---
import { perfil } from '../data/perfil';
import Icono from './Icono.astro';

const { servicios } = perfil;
---

<section id="que-hago" class="seccion tema-lavanda" aria-labelledby="que-hago-titulo">
  <div class="contenedor">
    <h2 id="que-hago-titulo" class="titulo-seccion reveal">{servicios.titulo}</h2>
    <p class="bajada servicios__bajada reveal">{servicios.bajada}</p>
    <ul class="servicios">
      {
        servicios.items.map((s, i) => (
          <li class="servicio reveal" style={`--retraso: ${(i % 4) * 0.06}s`}>
            <span class="servicio__icono">
              <Icono nombre={s.icono} />
            </span>
            <h3 class="servicio__titulo">{s.titulo}</h3>
            <p class="servicio__texto">{s.texto}</p>
            {s.ejemplos && (
              <div class="servicio__prueba">
                <p class="servicio__ejemplos-titulo">Ejemplos</p>
                <ul class="servicio__ejemplos">
                  {s.ejemplos.map((e) => (
                    <li>
                      <a href={`/proyectos/${e.slug}`}>
                        {e.texto}
                        <Icono nombre="flecha" />
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </li>
        ))
      }
    </ul>

    {
      servicios.incluye && (
        <div class="incluye reveal">
          <p class="incluye__titulo">{servicios.incluye.titulo}</p>
          <ul class="incluye__items">
            {servicios.incluye.items.map((item) => (
              <li class="incluye__item">{item}</li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</section>

<style>
  .servicios__bajada {
    margin-top: calc(-1 * clamp(0.75rem, 2vw, 1.75rem));
    margin-bottom: clamp(1.75rem, 4vw, 2.75rem);
  }
  .servicios {
    display: grid;
    gap: 1.25rem;
  }
  .servicio {
    display: flex;
    flex-direction: column;
    background: var(--blanco);
    border-radius: var(--radio-m);
    padding: clamp(1.5rem, 3vw, 1.85rem);
    border: 2px solid transparent;
    transition:
      transform 0.25s ease,
      border-color 0.25s ease;
  }
  .servicio:hover {
    transform: translateY(-6px);
    border-color: var(--violeta);
  }
  .servicio__icono {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    background: var(--lima);
    color: var(--tinta);
    margin-bottom: 1.25rem;
    transition: background-color 0.25s ease;
  }
  .servicio:hover .servicio__icono {
    background: var(--rosa);
  }
  .servicio__icono :global(svg) {
    width: 1.6rem;
    height: 1.6rem;
  }
  .servicio__titulo {
    font-family: var(--fuente-titulo);
    font-weight: 500;
    font-size: 1.0625rem;
    line-height: 1.3;
    margin-bottom: 0.6rem;
  }
  .servicio__texto {
    color: var(--tinta-suave);
    font-size: 1rem;
  }
  .servicio__prueba {
    margin-top: auto;
    padding-top: 1rem;
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.45;
    color: var(--violeta);
  }
  .servicio__prueba::before {
    content: '';
    display: block;
    width: 2.5rem;
    height: 4px;
    margin-bottom: 0.75rem;
    border-radius: 4px;
    background: var(--lima);
  }

  .servicio__ejemplos-titulo {
    font-family: var(--fuente-titulo);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--tinta);
    margin-bottom: 0.5rem;
  }
  .servicio__ejemplos {
    display: grid;
    gap: 0.4rem;
  }
  .servicio__ejemplos a {
    color: var(--violeta);
    text-decoration: underline;
    text-decoration-color: var(--linea);
    text-underline-offset: 3px;
  }
  .servicio__ejemplos a:hover {
    text-decoration-color: var(--violeta);
  }
  .servicio__ejemplos :global(svg) {
    display: inline-block;
    width: 1rem;
    height: 1rem;
    margin-left: 0.3rem;
    vertical-align: -0.15em;
  }
  .incluye {
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
  }
  .incluye__titulo {
    font-family: var(--fuente-titulo);
    font-weight: 500;
    font-size: 1rem;
  }
  .incluye__items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .incluye__item {
    padding: 0.45rem 0.95rem;
    border-radius: var(--pildora);
    background: var(--blanco);
    border: 2px solid var(--linea);
    font-size: 0.9375rem;
    font-weight: 500;
  }

  @media (min-width: 640px) {
    .servicios {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 960px) {
    .servicios {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
    }
  }
</style>
