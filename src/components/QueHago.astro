---
import { perfil } from '../data/perfil';
import Icono from './Icono.astro';

const { servicios } = perfil;
---

<section id="que-hago" class="seccion tema-lavanda" aria-labelledby="que-hago-titulo">
  <div class="contenedor">
    <h2 id="que-hago-titulo" class="titulo-seccion reveal">{servicios.titulo}</h2>
    <p class="bajada servicios__bajada reveal">{servicios.bajada}</p>
    <ul class="servicios">
      {
        servicios.items.map((s, i) => (
          <li class="servicio reveal" style={`--retraso: ${(i % 4) * 0.06}s`}>
            <span class="servicio__icono">
              <Icono nombre={s.icono} />
            </span>
            <h3 class="servicio__titulo">{s.titulo}</h3>
            <p class="servicio__texto">{s.texto}</p>
            <a class="servicio__ejemplo" href={`/proyectos/${s.ejemplo.slug}`}>
              <span class="servicio__ejemplo-etiqueta">Ejemplo</span>
              <span class="servicio__ejemplo-texto">
                {s.ejemplo.texto}
                <Icono nombre="flecha" />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .servicios__bajada {
    margin-top: calc(-1 * clamp(0.75rem, 2vw, 1.75rem));
    margin-bottom: clamp(1.75rem, 4vw, 2.75rem);
  }
  .servicios {
    display: grid;
    gap: 1.25rem;
  }
  .servicio {
    display: flex;
    flex-direction: column;
    background: var(--blanco);
    border-radius: var(--radio-m);
    padding: clamp(1.5rem, 3vw, 1.85rem);
    border: 2px solid transparent;
    transition:
      transform 0.25s ease,
      border-color 0.25s ease;
  }
  .servicio:hover {
    transform: translateY(-6px);
    border-color: var(--violeta);
  }
  .servicio__icono {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    background: var(--lima);
    color: var(--tinta);
    margin-bottom: 1.25rem;
    transition: background-color 0.25s ease;
  }
  .servicio:hover .servicio__icono {
    background: var(--rosa);
  }
  .servicio__icono :global(svg) {
    width: 1.6rem;
    height: 1.6rem;
  }
  .servicio__titulo {
    font-family: var(--fuente-titulo);
    font-weight: 600;
    font-size: 1.25rem;
    line-height: 1.3;
    margin-bottom: 0.6rem;
  }
  .servicio__texto {
    color: var(--tinta-suave);
    font-size: 1.0625rem;
  }
  .servicio__ejemplo {
    margin-top: auto;
    padding-top: 1.25rem;
    display: grid;
    gap: 0.25rem;
    color: var(--violeta);
    text-decoration: none;
  }
  .servicio__ejemplo::before {
    content: '';
    display: block;
    width: 2.5rem;
    height: 4px;
    margin-bottom: 0.75rem;
    border-radius: 4px;
    background: var(--lima);
  }
  .servicio__ejemplo-etiqueta {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--tinta-suave);
  }
  .servicio__ejemplo-texto {
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--linea);
    text-underline-offset: 4px;
  }
  .servicio__ejemplo:hover .servicio__ejemplo-texto {
    text-decoration-color: var(--violeta);
  }
  .servicio__ejemplo :global(svg) {
    display: inline-block;
    width: 1rem;
    height: 1rem;
    margin-left: 0.3rem;
    vertical-align: -0.15em;
  }

  @media (min-width: 640px) {
    .servicios {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 960px) {
    .servicios {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
    }
  }
</style>
